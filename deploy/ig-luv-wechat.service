[Unit]
Description=IG Luv WeChat Moments host collector
After=network.target

[Service]
Type=simple
User=wechat
Group=wechat
Environment=DATA_DIR=/opt/ig-luv/data
Environment=WECHAT_ACCOUNT_DIR=/mnt/data/wechat-home/xwechat_files/REPLACE_ME/db_storage
ExecStartPre=+/usr/bin/install -d -o wechat -g wechat -m 700 /opt/ig-luv/data/wechat
ExecStart=/usr/bin/python3 /opt/ig-luv/wechat_moments_host.py
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
