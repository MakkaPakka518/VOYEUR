[Unit]
Description=IG Luv WeChat Moments host collector
After=network.target

[Service]
Type=simple
User=wechat
Group=wechat
Environment=DATA_DIR=/opt/ig-luv/data
Environment=WECHAT_HOME=/mnt/data/wechat-home
Environment=WECHAT_SNS_TOOL=/mnt/data/wechat-tools/wechat-sns-source
Environment=WXEXTRACT=/mnt/data/wechat-tools/wxextract
EnvironmentFile=-/etc/ig-luv/wechat.env
ExecStartPre=+/usr/bin/install -d -o wechat -g wechat -m 700 /opt/ig-luv/data/wechat
ExecStart=/usr/bin/python3 /opt/ig-luv/wechat_moments_host.py
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
